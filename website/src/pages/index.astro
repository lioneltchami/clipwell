---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.svelte';
import ProductDemo from '../components/ProductDemo.svelte';
import WorkbenchSection from '../components/WorkbenchSection.svelte';
import SpecSection from '../components/SpecSection.svelte';
import ReleaseDownload from '../components/ReleaseDownload.svelte';
import TrustSection from '../components/TrustSection.svelte';
import PricingPreview from '../components/PricingPreview.svelte';
import FAQSection from '../components/FAQSection.svelte';
import CTASection from '../components/CTASection.svelte';
import DiveDeeper from '../components/DiveDeeper.svelte';

const siteUrl = 'https://lioneltchami.github.io/clipwell';
const repo = 'https://github.com/lioneltchami/clipwell';
const base = import.meta.env.BASE_URL;

const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareApplication',
		name: 'Clipwell',
		description:
			'Native macOS screen recorder with system audio, microphone, annotations, camera overlay, trim, and GIF export. Local files only.',
		applicationCategory: 'MultimediaApplication',
		operatingSystem: 'macOS 15.2+',
		url: siteUrl,
		downloadUrl: `${repo}/releases/latest`,
		offers: {
			'@type': 'Offer',
			price: '0',
			priceCurrency: 'USD',
			availability: 'https://schema.org/InStock'
		},
		author: {
			'@type': 'Person',
			name: 'Lionel Tchami',
			url: 'https://github.com/lioneltchami'
		},
		license: 'https://opensource.org/licenses/MIT',
		featureList: [
			'ScreenCaptureKit recording',
			'System audio and microphone',
			'Camera overlay layouts',
			'Click and keystroke overlays',
			'Annotation drawing',
			'Trim and GIF export',
			'Local-only storage'
		]
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'Clipwell',
		url: siteUrl,
		description: 'Native macOS screen recorder. Local files. MIT license.'
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: [
			{
				'@type': 'Question',
				name: 'Is Clipwell free?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Clipwell is free and MIT licensed; commercial service terms are not published.'
				}
			},
			{
				'@type': 'Question',
				name: 'Does Clipwell record system audio?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Yes — system audio and microphone can be captured together via ScreenCaptureKit.'
				}
			},
			{
				'@type': 'Question',
				name: 'What macOS version is required?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'macOS 15.2 Sequoia or later.'
				}
			}
		]
	}
];
---

<BaseLayout
	title="Clipwell — native macOS screen recorder"
	description="Menu-bar screen recorder for macOS. System audio, mic, annotations, camera overlay, trim, and GIF export. Local files only. MIT license."
	canonicalUrl={siteUrl}
	structuredData={structuredData}
>
	<Fragment slot="head">
		<meta name="application-name" content="Clipwell" />
		<meta name="author" content="Lionel Tchami" />
	</Fragment>

	<main id="main">
		<Hero client:load base={base} />
		<ProductDemo client:visible />
		<WorkbenchSection client:visible base={base} />
		<SpecSection client:visible />
		<ReleaseDownload client:visible />
		<TrustSection client:visible />
		<PricingPreview client:visible />
		<FAQSection client:visible />
		<DiveDeeper client:visible base={base} />
		<CTASection client:visible />
	</main>
</BaseLayout>