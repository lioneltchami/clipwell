---
import BaseLayout from '../layouts/BaseLayout.astro';
import OpenSourceHero from '../components/OpenSourceHero.svelte';
import OpenSourcePanel from '../components/OpenSourcePanel.svelte';
import ContributePanel from '../components/ContributePanel.svelte';
import CommercialFrameworkPanel from '../components/CommercialFrameworkPanel.svelte';

const siteUrl = 'https://lioneltchami.github.io/clipwell';
const pageUrl = `${siteUrl}/open-source`;
const base = import.meta.env.BASE_URL;

const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		name: 'Clipwell — Open source',
		url: pageUrl,
		description:
			'Clipwell is MIT-licensed source code. Attribution history (derived from BetterCapture by Joshua Sattler), contribution channels, and the non-operative commercial framework.'
	},
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareApplication',
		name: 'Clipwell',
		applicationCategory: 'MultimediaApplication',
		operatingSystem: 'macOS 15.2+',
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
		license: 'https://opensource.org/licenses/MIT'
	}
];
---

<BaseLayout
	title="Open source — Clipwell"
	description="Clipwell is MIT-licensed source code, derived from BetterCapture by Joshua Sattler. Contribution channels and the non-operative commercial framework."
	canonicalUrl={pageUrl}
	structuredData={structuredData}
>
	<main id="main">
		<OpenSourceHero client:load base={base} />
		<OpenSourcePanel client:visible />
		<ContributePanel client:visible />
		<CommercialFrameworkPanel client:visible />
	</main>
</BaseLayout>