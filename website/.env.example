# Stripe payment-link configuration for a future commercial offering.
# These values are public build-time configuration, not Stripe secret keys.
# Keep checkout disabled until product scope, price, taxes, fulfilment, refund policy,
# privacy disclosures, and support terms are final and reviewed.

PUBLIC_STRIPE_CHECKOUT_ENABLED=false
PUBLIC_STRIPE_PAYMENT_LINK=
PUBLIC_STRIPE_PRODUCT_LABEL=Commercial support
